// COURTSIDE Prisma Schema
// Sprint 1: 인증/프로필/스케줄/구독플랜/셀프신청/전화번호인증/약관관리

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  COACH
  ADMIN
}

enum SocialProvider {
  KAKAO
  NAVER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AgeGroup {
  TEENS
  TWENTIES
  THIRTIES
  FORTIES
  FIFTIES_PLUS
}

enum LessonFormat {
  INDIVIDUAL
  GROUP
}

enum LessonType {
  REGULAR
  COUPON
}

enum PriceVisibility {
  PUBLIC
  PRIVATE
}

model User {
  id               String          @id @db.Uuid
  email            String          @unique
  name             String?
  realName         String?
  birthDate        DateTime?       @db.Date
  role             Role?
  socialProvider   SocialProvider?
  socialId         String?
  profileImage     String?
  phone            String?
  isActive         Boolean         @default(true)
  marketingConsent Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  studentProfile  StudentProfile?
  coachProfile    CoachProfile?
  schedules       Schedule[]
  termsAgreements UserTermsAgreement[]
  rackets         UserRacket[]
  favoritePlayers FavoritePlayer[]

  // FR-16a: 오늘의 코트사이드 푸시 시간 ("HH:mm" or null=OFF, 기본 "08:00")
  dailyPushTime   String?         @default("08:00")

  @@unique([socialProvider, socialId])
  @@map("users")
}

model StudentProfile {
  id                    Int           @id @default(autoincrement())
  userId                String        @unique @db.Uuid
  gender                Gender
  ageGroup              AgeGroup
  ntrpLevel             String
  preferredAreaSido     String
  preferredAreaSigungu  String
  preferredLessonFormat LessonFormat?
  preferredTimeSlots    String[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonGoals StudentLessonGoalMapping[]

  @@map("student_profiles")
}

model StudentLessonGoalMapping {
  id               Int @id @default(autoincrement())
  studentProfileId Int
  lessonGoalId     Int

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  lessonGoal     LessonGoal     @relation(fields: [lessonGoalId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, lessonGoalId])
  @@map("student_lesson_goal_mappings")
}

model CoachProfile {
  id               Int             @id @default(autoincrement())
  userId           String          @unique @db.Uuid
  bio              String
  gender           Gender
  experienceYears  Int?
  lessonPrice      Int?
  priceVisibility  PriceVisibility @default(PRIVATE)
  areaSido         String
  areaSigungu      String
  ntrpMin          Float?
  ntrpMax          Float?
  allowRegular     Boolean         @default(true)
  allowCoupon      Boolean         @default(false)
  couponValidWeeks Int?
  averageRating    Float           @default(0)
  reviewCount      Int             @default(0)
  bookingCount     Int             @default(0)
  isVerified       Boolean         @default(false)
  verifiedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  images      CoachProfileImage[]
  specialties CoachSpecialtyMapping[]
  lessonTypes CoachLessonType[]

  @@map("coach_profiles")
}

model CoachProfileImage {
  id             Int      @id @default(autoincrement())
  coachProfileId Int
  url            String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  coachProfile CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)

  @@index([coachProfileId, sortOrder])
  @@map("coach_profile_images")
}

model CoachLessonType {
  id             Int          @id @default(autoincrement())
  coachProfileId Int
  lessonFormat   LessonFormat

  coachProfile CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)

  @@unique([coachProfileId, lessonFormat])
  @@map("coach_lesson_types")
}

model CoachSpecialty {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  label     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  mappings CoachSpecialtyMapping[]

  @@map("coach_specialties")
}

model CoachSpecialtyMapping {
  id             Int @id @default(autoincrement())
  coachProfileId Int
  specialtyId    Int

  coachProfile CoachProfile   @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)
  specialty    CoachSpecialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([coachProfileId, specialtyId])
  @@map("coach_specialty_mappings")
}

model LessonGoal {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  label     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  mappings StudentLessonGoalMapping[]

  @@map("lesson_goals")
}

model Schedule {
  id           Int       @id @default(autoincrement())
  coachId      String    @db.Uuid
  dayOfWeek    Int?
  specificDate DateTime? @db.Date
  slotTime     String
  isRecurring  Boolean   @default(true)
  isBlocked    Boolean   @default(false)
  bookingId    Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  coach User @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId, dayOfWeek, slotTime])
  @@map("schedules")
}

model Lesson {
  id                  Int       @id @default(autoincrement())
  coachId             String    @db.Uuid
  studentId           String    @db.Uuid
  scheduledAt         DateTime
  durationMinutes     Int       @default(60)

  // status: PENDING | CONFIRMED | IN_PROGRESS | COMPLETED | ABSENT
  //       | RESCHEDULE_REQUESTED | RESCHEDULE_COMPLETED
  //       | MAKEUP_PENDING | MAKEUP_CONFIRMED | MAKEUP_REQUESTED
  //       | MERGE | SPLIT
  status              String    @default("CONFIRMED")

  // paymentStatus: PAID | UNPAID | EXTERNAL | NONE
  // - 신규 레슨 default = UNPAID (미결제)
  // - PAID 도달 경로: ① 결제 모듈 자동 결제 완료, ② 코치가 레슨 상세에서 '결제 확인' 클릭
  //   (두 경로 모두 동일 PAID 상태값으로 표시)
  // - NONE: 보강 등 결제 대상이 아닌 회차
  paymentStatus       String    @default("UNPAID")

  // lessonFormat: PRIVATE | GROUP
  lessonFormat        String    @default("PRIVATE")

  // 회차 표시용 (예: 5/8회)
  roundNumber         Int?
  totalRounds         Int?

  // 변경 회차의 원래 일정 시각 (RESCHEDULE_COMPLETED 카드에서 이전 시간 취소선 표시)
  originalScheduledAt DateTime?

  // 변경/보강 회차의 원본 회차 참조
  originalLessonId    Int?

  // 통합/분할 회차의 부모 참조
  parentLessonId      Int?

  // 분할 회차 정보 (예: 1/2, 2/2)
  splitIndex          Int?
  splitTotal          Int?

  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([coachId, scheduledAt])
  @@index([studentId, scheduledAt])
  @@index([originalLessonId])
  @@index([parentLessonId])
  @@map("lessons")
}

model SubscriptionPlan {
  id           Int     @id @default(autoincrement())
  code         String  @unique
  name         String
  price        Int
  billingCycle String
  isBest       Boolean @default(false)
  discount     String?
  ctaText      String
  ctaStyle     String
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  studentLimit       Int?
  alimtalkLimit      Int?
  hasStats           Boolean @default(false)
  hasMemberSearch    Boolean @default(false)
  hasCsvExport       Boolean @default(false)
  hasPrioritySupport Boolean @default(false)
  hasAutoRegular     Boolean @default(false)

  features  SubscriptionPlanFeature[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription_plans")
}

model SubscriptionPlanFeature {
  id        Int     @id @default(autoincrement())
  planId    Int
  code      String
  label     String
  enabled   Boolean @default(true)
  sortOrder Int     @default(0)

  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder])
  @@map("subscription_plan_features")
}

model StudentSelfClaim {
  id                 Int       @id @default(autoincrement())
  studentUserId      String    @db.Uuid
  claimedCoachName   String
  claimedCoachPhone  String
  matchedCoachUserId String?   @db.Uuid
  status             String    @default("PENDING")
  notifiedAt         DateTime?
  notifyAttempts     Int       @default(0)
  notifyLastError    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([studentUserId])
  @@index([matchedCoachUserId])
  @@index([claimedCoachPhone])
  @@map("student_self_claims")
}

model PhoneVerification {
  id           Int       @id @default(autoincrement())
  phone        String
  code         String
  expiresAt    DateTime
  verifiedAt   DateTime?
  attemptCount Int       @default(0)
  ip           String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([phone, createdAt])
  @@map("phone_verifications")
}

// ===== 9. 약관 관리 (이용약관 / 개인정보 처리방침 / 마케팅 동의) =====

model Terms {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  title       String
  isRequired  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions TermsVersion[]

  @@map("terms")
}

model TermsVersion {
  id            Int      @id @default(autoincrement())
  termsId       Int
  version       String
  content       String
  effectiveDate DateTime @db.Date
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())

  terms      Terms                @relation(fields: [termsId], references: [id], onDelete: Cascade)
  agreements UserTermsAgreement[]

  @@index([termsId, isActive])
  @@map("terms_versions")
}

model UserTermsAgreement {
  id             Int      @id @default(autoincrement())
  userId         String   @db.Uuid
  termsVersionId Int
  agreedAt       DateTime @default(now())
  ip             String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion TermsVersion @relation(fields: [termsVersionId], references: [id], onDelete: Cascade)

  @@unique([userId, termsVersionId])
  @@index([userId])
  @@map("user_terms_agreements")
}

// ─────────────────────────────────────────────────────────────────────
// FR-16: 학생 리텐션 콘텐츠 (오늘의 코트사이드 / 내 라켓 / 그랜드슬램)
// ─────────────────────────────────────────────────────────────────────

enum DailyContentType {
  WEATHER
  KR_MATCH
  HIGHLIGHT
  LOCAL_TOURNAMENT
}

enum RacketBrand {
  WILSON
  BABOLAT
  HEAD
  YONEX
  PRINCE
  DUNLOP
  TECNIFIBRE
  PROKENNEX
}

enum TournamentType {
  GRAND_SLAM
  ATP
  WTA
  LOCAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum ProTour {
  ATP
  WTA
}

enum RacketNewsType {
  NEW_MODEL
  SALE
  STRING_TIP
  REVIEW
}

/// FR-16a 오늘의 코트사이드 콘텐츠 캐시 (외부 API + AI 요약 + 어드민 검수)
model DailyContent {
  id           Int              @id @default(autoincrement())
  contentDate  DateTime         @db.Date
  type         DailyContentType
  region       String?          // WEATHER / LOCAL_TOURNAMENT 한정 (시·군·구)
  title        String
  summary      String?
  body         String?
  externalUrl  String?
  meta         Json?            // 기온/풍속/PM10/선수명/스코어 등
  isPublished  Boolean          @default(true)
  createdAt    DateTime         @default(now())

  @@index([contentDate, type, region])
  @@map("daily_contents")
}

/// FR-16b 라켓 마스터 (어드민 관리)
model Racket {
  id          Int         @id @default(autoincrement())
  brand       RacketBrand
  model       String
  headSize    Int?
  weight      Int?
  imageUrl    String?
  releaseYear Int?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  userRackets UserRacket[]
  proPlayers  ProPlayer[]
  news        RacketNews[]

  @@unique([brand, model])
  @@map("rackets")
}

/// FR-16b 학생-라켓 매핑 (현재 사용 라켓 + 이력)
model UserRacket {
  id                   Int       @id @default(autoincrement())
  userId               String    @db.Uuid
  racketId             Int
  stringType           String?
  stringTension        Int?      // lbs (30~70)
  lastStringChangeDate DateTime? @db.Date
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  racket           Racket            @relation(fields: [racketId], references: [id])
  stringChangeLogs StringChangeLog[]

  @@index([userId, isActive])
  @@map("user_rackets")
}

/// FR-16b 스트링 교체 이력 (평균 주기 산출용)
model StringChangeLog {
  id           Int      @id @default(autoincrement())
  userRacketId Int
  changeDate   DateTime @db.Date
  tension      Int?
  stringType   String?
  memo         String?
  createdAt    DateTime @default(now())

  userRacket UserRacket @relation(fields: [userRacketId], references: [id], onDelete: Cascade)

  @@index([userRacketId, changeDate])
  @@map("string_change_logs")
}

/// FR-16b/c 프로 선수 마스터
model ProPlayer {
  id        Int      @id @default(autoincrement())
  name      String
  nameKo    String?
  country   String   // ISO 2자리 (IT, KR, US 등)
  tour      ProTour
  racketId  Int?
  atpRank   Int?
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  racket    Racket?          @relation(fields: [racketId], references: [id])
  matches1  ProMatch[]       @relation("Player1")
  matches2  ProMatch[]       @relation("Player2")
  favorited FavoritePlayer[]

  @@map("pro_players")
}

/// FR-16c 즐겨찾기 선수 (경기 1시간 전 알림)
model FavoritePlayer {
  id          Int      @id @default(autoincrement())
  userId      String   @db.Uuid
  proPlayerId Int
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  proPlayer ProPlayer @relation(fields: [proPlayerId], references: [id], onDelete: Cascade)

  @@unique([userId, proPlayerId])
  @@map("favorite_players")
}

/// FR-16a/c 대회 마스터 (그랜드슬램 + ATP/WTA + 동호인)
model Tournament {
  id                    Int            @id @default(autoincrement())
  name                  String
  nameKo                String?
  type                  TournamentType
  city                  String
  utcOffsetMinutes      Int            // 호주=+660 등
  startDate             DateTime       @db.Date
  endDate               DateTime       @db.Date
  region                String?        // LOCAL 한정 (시·군·구)
  minNtrp               Decimal?       @db.Decimal(2, 1)
  maxNtrp               Decimal?       @db.Decimal(2, 1)
  broadcastChannels     String[]
  externalUrl           String?
  registrationDeadline  DateTime?      @db.Date
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())

  matches ProMatch[]

  @@index([type, startDate])
  @@map("tournaments")
}

/// FR-16a/c 프로 경기 일정·결과
model ProMatch {
  id            Int         @id @default(autoincrement())
  tournamentId  Int
  round         String      // R32 / QF / SF / F 등
  player1Id     Int
  player2Id     Int
  scheduledAt   DateTime    // UTC
  status        MatchStatus @default(SCHEDULED)
  winnerId      Int?
  score         String?
  highlightUrl  String?
  aiSummary     String?
  createdAt     DateTime    @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player1    ProPlayer  @relation("Player1", fields: [player1Id], references: [id])
  player2    ProPlayer  @relation("Player2", fields: [player2Id], references: [id])

  @@index([scheduledAt, status])
  @@index([tournamentId, round])
  @@map("pro_matches")
}

/// FR-16b 라켓 뉴스·할인 (어드민 입력)
model RacketNews {
  id             Int            @id @default(autoincrement())
  type           RacketNewsType
  targetBrand    RacketBrand?
  targetRacketId Int?
  title          String
  body           String?
  imageUrl       String?
  externalUrl    String?
  publishedAt    DateTime       @default(now())
  isActive       Boolean        @default(true)

  targetRacket Racket? @relation(fields: [targetRacketId], references: [id])

  @@index([type, publishedAt])
  @@map("racket_news")
}
